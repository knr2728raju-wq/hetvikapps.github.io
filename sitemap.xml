        <div><h4>Apps</h4><ul><li><a href="apps.html">ExpenseNest</a></li><li><a href="apps.html">Coming soon</a></li></ul></div>
        <div><h4>Legal</h4><ul><li><a href="privacy-policy.html">Privacy Policy</a></li><li><a href="terms.html">Terms &amp; Conditions</a></li><li><a href="app-ads.html">app-ads.txt</a></li></ul></div>
      </div>
      <div class="footer-bottom">
        <span>© <span data-year>2025</span> Hetvik Apps. All rights reserved.</span>
        <div class="fb-links"><a href="privacy-policy.html">Privacy</a><a href="terms.html">Terms</a><a href="contact.html">Contact</a><a href="mailto:support@hetvikapps.com">support@hetvikapps.com</a></div>
      </div>
    </div>
  </footer>

  <button class="to-top" aria-label="Back to top"><i class="fa-solid fa-arrow-up"></i></button>
  <script src="assets/js/main.js"></script>
</body>
