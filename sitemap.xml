    <a href="apps.html" class="btn btn-primary btn-block">Explore Apps</a>
  </div>

  <main>
    <section class="page-hero">
      <div class="container">
        <div class="breadcrumb reveal"><a href="index.html">Home</a> <i class="fa-solid fa-chevron-right"></i> <span>Contact</span></div>
        <h1 class="reveal d1">Let's <span class="text-gradient">talk</span></h1>
        <p class="reveal d2">Questions, feedback or ideas — we're always happy to hear from you.</p>
      </div>
    </section>

    <section class="section" style="padding-top:20px;">
      <div class="container contact-grid">
        <!-- INFO -->
        <div class="contact-info reveal">
          <div class="contact-line">
            <span class="ci-ic"><i class="fa-solid fa-user"></i></span>
            <div><small>Developer</small><b>Hetvik Apps</b></div>
          </div>
          <div class="contact-line">
            <span class="ci-ic"><i class="fa-solid fa-envelope"></i></span>
            <div><small>Email</small><b><a href="mailto:support@hetvikapps.com">support@hetvikapps.com</a></b></div>
          </div>
          <div class="contact-line">
            <span class="ci-ic"><i class="fa-solid fa-clock"></i></span>
            <div><small>Response time</small><b>Usually within 1–2 days</b></div>
          </div>
          <div>
            <p style="color:var(--text-soft);margin:6px 0 12px;font-weight:500;">Follow us</p>
            <div class="social-row">
              <a href="#" class="social-btn" aria-label="Twitter / X"><i class="fa-brands fa-x-twitter"></i></a>
              <a href="#" class="social-btn" aria-label="GitHub"><i class="fa-brands fa-github"></i></a>
              <a href="#" class="social-btn" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
              <a href="#" class="social-btn" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
              <a href="#" class="social-btn" aria-label="Google Play"><i class="fa-brands fa-google-play"></i></a>
            </div>
          </div>
        </div>

        <!-- FORM -->
        <div class="card form-card reveal d1">
          <div class="form-status"><i class="fa-solid fa-circle-check"></i><span>Thanks! Your message is ready.</span></div>
          <form data-contact-form novalidate>
            <div class="form-row">
              <div class="field">
                <label for="name">Name</label>
                <input type="text" id="name" name="name" placeholder="Your name" required>
              </div>
              <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="you@example.com" required>
              </div>
            </div>
            <div class="field">
              <label for="subject">Subject</label>
              <select id="subject" name="subject">
                <option>General enquiry</option>
                <option>App support</option>
                <option>Feature request</option>
                <option>Feedback</option>
                <option>Business / partnership</option>
              </select>
            </div>
            <div class="field">
              <label for="message">Message</label>
              <textarea id="message" name="message" placeholder="How can we help?" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-lg"><i class="fa-solid fa-paper-plane"></i> Send message</button>
            <p class="form-note"><i class="fa-solid fa-lock"></i> This is a front-end demo form — connect it to your email service or a form backend to receive messages.</p>
          </form>
        </div>
      </div>
    </section>

    <!-- MAP -->
    <section class="section" style="padding-top:0;">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">Find us</span>
          <h2 class="section-title">On the map</h2>
        </div>
        <div class="map-embed reveal d1">
          <div class="map-lines" aria-hidden="true"></div>
          <div class="map-pin">
            <i class="fa-solid fa-location-dot"></i>
            <p style="font-weight:600;color:var(--heading);">Hetvik Apps</p>
            <p style="font-size:.9rem;">Google Maps placeholder — embed your location's iframe here.</p>
          </div>
        </div>
        <div class="callout reveal" style="margin-top:20px;">
          <i class="fa-solid fa-map-location-dot"></i>
          <div>To show a live map, replace this block with a Google Maps <code>&lt;iframe&gt;</code> embed for your address.</div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
